# Copy to .env.local (git-ignored) and adjust.

# Which services call the real FastAPI backend, comma-separated. The others use the
# in-browser mock data in src/mocks/. Empty = everything mock (no backend needed).
# Services: auth, users, comics, shelves, sources, tags, stats, notifications
# Real services need a real login, so include "auth" whenever the list isn't empty.
VITE_REAL_SERVICES=

# Global override (optional). Leave it unset to use VITE_REAL_SERVICES.
#   true  = every service uses mock data
#   false = every service calls the real API
# VITE_USE_MOCK=

# Backend origin, without a trailing slash (every path starts with /api).
# Empty = same origin: the app calls /api/... and the Vite dev server proxies it to
# API_PROXY_TARGET. In production, set it to the backend's URL (or add an /api rewrite).
VITE_API_URL=

# Dev server only (never sent to the browser): where the /api proxy forwards requests.
API_PROXY_TARGET=http://localhost:8000
