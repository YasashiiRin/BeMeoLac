# Copy to .env.local (git-ignored) and adjust.

# true  = use the in-browser mock data in src/mocks/ (no backend needed)
# false = call the real FastAPI backend at VITE_API_URL
VITE_USE_MOCK=true

# Backend origin, without a trailing slash. Every endpoint path starts with /api.
# Only used when VITE_USE_MOCK=false.
VITE_API_URL=http://localhost:8000
